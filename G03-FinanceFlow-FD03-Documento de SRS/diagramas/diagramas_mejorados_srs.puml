actor Usuario
participant RegisterPage
participant authService
participant Backend
Usuario -> RegisterPage : llena datos
RegisterPage -> authService : submit
authService -> Backend : register
Backend --> authService : response
authService --> RegisterPage : mostrar estado
@enduml

@startuml
title 25. Secuencia de dashboard en tiempo real
participant DashboardPage
participant movimientosService
participant Backend
database MongoDB
DashboardPage -> movimientosService : cargarResumen()
movimientosService -> Backend : GET /dashboard
Backend -> MongoDB : consultar datos
MongoDB --> Backend : resumen
Backend --> movimientosService : datos
movimientosService --> DashboardPage : renderizar graficos
@enduml

@startuml
title 26. Secuencia de OCR y autocompletado
participant MovimientoFormPage
participant MicroservicioPython
participant ModeloML
MovimientoFormPage -> MicroservicioPython : enviar imagen
MicroservicioPython -> ModeloML : extraer categoria
ModeloML --> MicroservicioPython : categoria sugerida
MicroservicioPython --> MovimientoFormPage : autocompletar campos
@enduml

@startuml
title 27. Secuencia de eliminacion logica
actor Usuario
participant ReportesPage
participant Backend
database MongoDB
Usuario -> ReportesPage : confirma eliminar
ReportesPage -> Backend : PATCH /movimientos/:id
Backend -> MongoDB : estado = inactivo
MongoDB --> Backend : ok
Backend --> ReportesPage : actualizar lista
@enduml

@startuml
title 28. Secuencia de filtros y reportes
actor Usuario
participant ReportesPage
participant Backend
database MongoDB
Usuario -> ReportesPage : aplica filtros
ReportesPage -> Backend : GET /reportes?filtro
Backend -> MongoDB : consultar datos filtrados
MongoDB --> Backend : resultados
Backend --> ReportesPage : graficos y tabla
@enduml

@startuml
title 29. Secuencia de cambio de contrasena
actor Usuario
participant RecoveryPage
participant Backend
database MongoDB
Usuario -> RecoveryPage : ingresa nueva clave
RecoveryPage -> Backend : POST /reset-password
Backend -> MongoDB : actualizar hash
MongoDB --> Backend : ok
Backend --> RecoveryPage : acceso renovado
@enduml

@startuml
title 30. Secuencia de cierre de sesion
actor Usuario
participant Navbar
participant authService
participant Router
Usuario -> Navbar : clic en cerrar sesion
Navbar -> authService : logout()
authService --> Navbar : token eliminado
Navbar -> Router : navigate('/login')
@enduml

@startuml
title 31. Secuencia de perfil
actor Usuario
participant ProfilePage
participant Backend
database MongoDB
Usuario -> ProfilePage : cambia datos
ProfilePage -> Backend : PUT /profile
Backend -> MongoDB : actualizar usuario
MongoDB --> Backend : ok
Backend --> ProfilePage : perfil actualizado
@enduml

@startuml
title 32. Secuencia de logs
actor Administrador
participant LogsPage
participant Backend
database MongoDB
Administrador -> LogsPage : abrir auditoria
LogsPage -> Backend : GET /logs
Backend -> MongoDB : obtener eventos
MongoDB --> Backend : logs
Backend --> LogsPage : mostrar trazas
@enduml

