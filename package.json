{
  "name": "financeflow",
  "version": "1.3.0",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm --prefix backend start\" \"npm --prefix frontend start\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm --prefix backend run dev\" \"npm --prefix frontend start\"",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install && npm --prefix sdk install && npm --prefix mobile install",
    "test": "npm --prefix backend test && npm --prefix frontend run test:ci",
    "test:backend": "npm --prefix backend test",
    "test:backend:coverage": "npm --prefix backend test -- --coverage",
    "test:frontend": "npm --prefix frontend run test:ci",
    "test:frontend:coverage": "npm --prefix frontend test -- --watchAll=false --coverage",
    "test:sdk": "npm --prefix sdk test -- tests/sdk.test.js tests/sdk-integration.test.js",
    "test:sdk:all": "npm --prefix sdk test",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:sdk",
    "audit:backend": "npm --prefix backend audit --audit-level=high",
    "audit:frontend": "npm --prefix frontend audit --audit-level=high"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.0.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "test": "npm --prefix backend test && npm --prefix frontend run test:ci",
    "test:backend": "npm --prefix backend test",
    "test:backend:coverage": "npm --prefix backend test -- --coverage",
    "test:frontend": "npm --prefix frontend run test:ci",
    "test:frontend:coverage": "npm --prefix frontend test -- --watchAll=false --coverage",
    "test:sdk": "npm --prefix sdk test -- tests/sdk.test.js tests/sdk-integration.test.js",
    "test:sdk:all": "npm --prefix sdk test",
    "audit:backend": "npm --prefix backend audit",
    "audit:frontend": "npm --prefix frontend audit"
  }
}